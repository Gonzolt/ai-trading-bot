# Free Massive Stocks Basic key used only for historical US-stock training data.
MASSIVE_API_KEY=your_massive_free_key

# Optional free Finnhub key. Yahoo RSS is used when this is absent.
FINNHUB_API_KEY=your_finnhub_free_key

# Alpaca PAPER credentials are only required when Start Paper Trading is used.
# Never commit the populated .env file.
APCA_API_KEY_ID=your_paper_key_id
APCA_API_SECRET_KEY=your_paper_secret_key
