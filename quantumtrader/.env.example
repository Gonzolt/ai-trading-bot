# PostgreSQL / TimescaleDB
POSTGRES_USER=trader
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=quantumtrader
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://trader:change_me_strong_password@db:5432/quantumtrader

# Redis
REDIS_URL=redis://redis:6379/0

# MongoDB (news & sentiment)
MONGO_URL=mongodb://mongo:27017
MONGO_DB=quantumtrader

# Dashboard auth (change before production)
JWT_SECRET=change-me-to-a-long-random-string
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=QuantumTrader2026!

# Trading mode: paper | live
TRADING_MODE=paper
ENABLE_LIVE_TRADING=false

# Broker APIs
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# Market data APIs (optional – yfinance works without keys)
POLYGON_API_KEY=
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=

# MetaTrader5 (forex/CFDs – optional, host must run MT5 terminal)
MT5_ENABLED=false
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# SSL (optional – set DOMAIN for Let's Encrypt via install.sh)
DOMAIN=
LETSENCRYPT_EMAIL=

# Repository clone URL (used by install.sh)
REPO_URL=https://github.com/YOUR_ORG/QuantumTrader.git
